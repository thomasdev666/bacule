<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vérifie que les scripts Unity compilent, sans ouvrir Unity, contre les assemblies de référence de Unity
    publiées sur NuGet (API 2021.3 : un peu plus ancienne que Unity 6, donc on vérifie le chemin compatible).
    Lancer : dotnet build Tools/CompileCheck
    Ajouter -p:ExtraDefines="UNITY_ANDROID" pour vérifier le code propre à Android.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0436;NU1701</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_2021_3_OR_NEWER;$(ExtraDefines)</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Bascule/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Bascule/Scripts/Runtime/**/*.cs" />
    <Compile Include="MobileStubs.cs" />
    <Compile Include="PackageStubs.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2020.3.21" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
</Project>
