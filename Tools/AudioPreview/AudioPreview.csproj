<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exporte en WAV la musique et les bruitages fabriqués par le code, plus une démo « la partie devient tendue ». Lancer : dotnet run, avec le dossier de sortie en argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Bascule/Scripts/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
